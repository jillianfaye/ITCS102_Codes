        if yrs >= 5.0:
            base_fee = max_loan *0.02
            print("Years in business greater than 5 years base fee is", base_fee)
        else:
            base_fee = max_loan * 0.35
            print("Years in business lower than 5 years base fee is", base_fee)
    elif cc < 620:#tier3
        print("Credit score too low")
    else:
        print(" INVALID: does not meet baseline requirements")

#collateral
        if c_value >= max_loan:
            print("COLLATERAL", collateral, " with value of ", c_value, " is accepted")
        else:
            print("Rejected: Insufficient collateral value for", collateral)

#surcharge
        if c_value %5000 != 0:
            base_fee += 250
            print("Additional charge added to base fee. Total base fee is now", base_fee)
        else:
            print("Collateral value divisible by 5000")
else:
    print("REJECTED: Baseline requirements not met")