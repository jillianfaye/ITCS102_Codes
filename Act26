import random
import sys

import pygame

# ============================================================
# PART 1: SETTINGS (safe to change)
# ============================================================
SPEED = 8                      # frames per second (higher = faster)
GRID_WIDTH = 24
GRID_HEIGHT = 18
CELL_SIZE = 25
START_LENGTH = 3
POINTS_PER_FOOD = 1
WALLS_KILL = True              # False = snake wraps through walls
SNAKE_COLOR = (90, 200, 120)
GAME_TITLE = "Snake"

BG_COLOR = (20, 20, 30)
FOOD_COLOR = (230, 50, 50)
TEXT_COLOR = (240, 240, 240)

# Level 3, edit 1: rocks
ROCK_COLOR = (130, 130, 140)
ROCKS = [(6, 5), (7, 5), (8, 5), (15, 12), (16, 12), (17, 12)]

# ============================================================
# PART 2: SETUP (leave it)
# ============================================================
pygame.init()
screen = pygame.display.set_mode((GRID_WIDTH * CELL_SIZE, GRID_HEIGHT * CELL_SIZE))
pygame.display.set_caption(GAME_TITLE)
clock = pygame.time.Clock()
font = pygame.font.SysFont(None, 32)


# ============================================================
# PART 3: FUNCTIONS (how things look)
# ============================================================
def draw_square(pos, color):
    rect = pygame.Rect(pos[0] * CELL_SIZE, pos[1] * CELL_SIZE, CELL_SIZE - 1, CELL_SIZE - 1)
    pygame.draw.rect(screen, color, rect)


def draw_text(text, y):
    img = font.render(text, True, TEXT_COLOR)
    screen.blit(img, (10, y))


def place_food(snake):
    while True:
        spot = (random.randrange(GRID_WIDTH), random.randrange(GRID_HEIGHT))
        # Level 3, edit 2: food never lands on a rock
        if spot not in snake and spot not in ROCKS:
            return spot


def draw_game(snake, food, score):
    screen.fill(BG_COLOR)
    # Level 3, edit 3: draw rocks before the snake
    for rock in ROCKS:
        draw_square(rock, ROCK_COLOR)
    for part in snake:
        draw_square(part, SNAKE_COLOR)
    # Level 2 C: round food
    center = (food[0] * CELL_SIZE + CELL_SIZE // 2, food[1] * CELL_SIZE + CELL_SIZE // 2)
    pygame.draw.circle(screen, FOOD_COLOR, center, CELL_SIZE // 2)
    draw_text("Score: " + str(score), 10)


# ============================================================
# PART 4: GAME LOOP (events -> update -> draw)
# ============================================================
high_score = 0  # Level 2 D

while True:  # one pass = one game
    snake = [(GRID_WIDTH // 2 - i, GRID_HEIGHT // 2) for i in range(START_LENGTH)]
    direction = (1, 0)
    next_direction = direction
    score = 0
    food = place_food(snake)
    alive = True

    while alive:
        # ---- events ----
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            elif event.type == pygame.KEYDOWN:
                # Level 2 A: arrows + WASD
                if event.key in (pygame.K_UP, pygame.K_w) and direction != (0, 1):
                    next_direction = (0, -1)
                elif event.key in (pygame.K_DOWN, pygame.K_s) and direction != (0, -1):
                    next_direction = (0, 1)
                elif event.key in (pygame.K_LEFT, pygame.K_a) and direction != (1, 0):
                    next_direction = (-1, 0)
                elif event.key in (pygame.K_RIGHT, pygame.K_d) and direction != (-1, 0):
                    next_direction = (1, 0)

        # ---- update ----
        direction = next_direction
        new_head = (snake[0][0] + direction[0], snake[0][1] + direction[1])

        if WALLS_KILL:
            if not (0 <= new_head[0] < GRID_WIDTH and 0 <= new_head[1] < GRID_HEIGHT):
                alive = False
        else:
            new_head = (new_head[0] % GRID_WIDTH, new_head[1] % GRID_HEIGHT)

        # Level 3, edit 4: rocks kill too
        if new_head in snake or new_head in ROCKS:
            alive = False

        if alive:
            snake.insert(0, new_head)
            if new_head == food:
                score += POINTS_PER_FOOD
                food = place_food(snake)
                # Level 2 B (optional): uncomment to speed up after every food
                # SPEED = SPEED + 1
            else:
                snake.pop()

        # ---- draw ----
        draw_game(snake, food, score)
        if score > high_score:
            high_score = score
        draw_text("Best: " + str(high_score), 40)
        pygame.display.flip()
        clock.tick(SPEED)

    # ---- game over screen ----
    draw_text("Game over!  R = play again, Q = quit", GRID_HEIGHT * CELL_SIZE // 2)
    pygame.display.flip()
    waiting = True
    while waiting:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_r:
                    waiting = False
                elif event.key == pygame.K_q:
                    pygame.quit()
                    sys.exit()
        clock.tick(15)
